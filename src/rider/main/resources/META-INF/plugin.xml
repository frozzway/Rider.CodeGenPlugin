<idea-plugin require-restart="true">
    <id>com.jetbrains.rider.plugins.codegenjetbrains</id>
    <name>RiderCodeGen</name>
    <version>1.7.0</version>
    <vendor url="https://github.com/frozzway">Aleksandr Okunev</vendor>
    <depends>com.intellij.modules.rider</depends>
    <depends>com.intellij.database</depends>

    <description>Useful utils for code generation</description>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.jetbrains.rider.plugins.codegenjetbrains.DatabaseSchemaListener"/>
        <postStartupActivity implementation="com.jetbrains.rider.plugins.codegenjetbrains.VcsIntegrationListener"/>
    </extensions>

    <actions>
        <group id="com.jetbrains.rider.plugins.codegenjetbrains.actions.CodeGenActionGroup"
               class="com.jetbrains.rider.plugins.codegenjetbrains.actions.CodeGenActionGroup"
               popup="true">
            <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
            <action id="generate-command-action-id" class="com.jetbrains.rider.plugins.codegenjetbrains.actions.testsgeneration.GenerateCommandAction" />
            <action id="create-test-action-id" class="com.jetbrains.rider.plugins.codegenjetbrains.actions.testsgeneration.CreateTestAction" />
            <action id="update-test-action-id" class="com.jetbrains.rider.plugins.codegenjetbrains.actions.testsgeneration.UpdateTestAction" />
            <action id="get-many-test-action-id" class="com.jetbrains.rider.plugins.codegenjetbrains.actions.testsgeneration.GetManyTestAction" />
            <action id="get-grid-test-action-id" class="com.jetbrains.rider.plugins.codegenjetbrains.actions.testsgeneration.GetGridTestAction" />
            <action id="generate-repository-action-id" class="com.jetbrains.rider.plugins.codegenjetbrains.actions.GenerateRepositoryAction" />
            <action id="generate-controller-action-id" class="com.jetbrains.rider.plugins.codegenjetbrains.actions.GenerateControllerAction" />
        </group>
<!--        <action id="sample-action-id" class="com.jetbrains.rider.plugins.codegenjetbrains.actions.SampleAction">-->
<!--            <keyboard-shortcut keymap="$default" first-keystroke="shift control T"/>-->
<!--            <keyboard-shortcut keymap="Visual Studio" first-keystroke="shift control T"/>-->
<!--            <keyboard-shortcut keymap="Visual Studio OSX" first-keystroke="shift meta T"/>-->
<!--        </action>-->
    </actions>
</idea-plugin>
