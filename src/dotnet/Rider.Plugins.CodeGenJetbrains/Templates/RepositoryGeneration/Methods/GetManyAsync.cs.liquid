public async Task<IEnumerable<{{ Entity.Name }}>> GetManyAsync(CancellationToken cancellationToken)
{
    const string sql =
        $"""
        SELECT
            {%- for prop in Properties %}
            {{ Table.Name }}.{{ prop.Column }} AS {nameof({{Entity.Name}}.{{ prop.Name }})}{% unless forloop.last %},{%endunless%}
            {%- endfor %}
        FROM {{ Table.FullName }}
        """;

    var parameters = new {};

    var definition = new CommandDefinition(
        sql,
        parameters,
        transaction: _unitOfWork.Transaction,
        cancellationToken: cancellationToken);

    return await _unitOfWork.Connection.QueryAsync<{{ Entity.Name }}>(definition);
}
